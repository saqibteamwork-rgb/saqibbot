{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/dashboard",
      "destination": "/schedule.html"
    },
    {
      "source": "/api/:match*",
      "destination": "https://saqib-bot-s2-1cceb03e9698.herokuapp.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://saqib-bot-s2-1cceb03e9698.herokuapp.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
