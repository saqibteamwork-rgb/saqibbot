{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://saqib-bot-v1-d3ecc6f0292e.herokuapp.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://saqib-bot-v1-d3ecc6f0292e.herokuapp.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
